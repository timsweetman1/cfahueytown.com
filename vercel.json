{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/benefits",
      "destination": "/api/team-care"
    },
    {
      "source": "/benefits/:path*",
      "destination": "/api/team-care"
    }
  ],
  "functions": {
    "api/team-care.js": {
      "includeFiles": "team-care/dist/**",
      "maxDuration": 30
    }
  }
}
