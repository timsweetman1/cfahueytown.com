{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {"source": "/orientation", "destination": "/orientation/start", "permanent": false},
    {"source": "/benefits", "destination": "https://hueytown-team-care.agenttimblog.chatgpt.site/", "permanent": false},
    {"source": "/benefits/", "destination": "https://hueytown-team-care.agenttimblog.chatgpt.site/", "permanent": false}
  ],
  "rewrites": [
    {"source": "/orientation/service/:op", "destination": "/api/orientation?op=:op"},
    {"source": "/orientation/:path*", "destination": "/orientation-ui/index.html"}
  ],
  "headers": [
    {"source": "/orientation-ui/:path*", "headers": [{"key":"Cache-Control","value":"no-cache"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Robots-Tag","value":"noindex, nofollow"}]},
    {"source": "/orientation/:path*", "headers":[{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Robots-Tag","value":"noindex, nofollow"}]}
  ],
  "functions": {"api/orientation.js":{"includeFiles":"orientation/server/**","maxDuration":30}}
}
